<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♡ Cute Pet Overlay ♡"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#E86A92" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your tiny buddy on every screen!"
            android:textColor="#8A7A85"
            android:layout_marginBottom="12dp" />

        <com.cutepet.overlay.PetView
            android:id="@+id/petPreview"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:text="○ OFF"
            android:textColor="#5B4A5A"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pet ON / OFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#5B4A5A" />

            <Switch
                android:id="@+id/switchOn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose your pet"
            android:textStyle="bold"
            android:textColor="#5B4A5A"
            android:layout_marginBottom="6dp" />

        <RadioGroup
            android:id="@+id/petGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:padding="10dp"
            android:layout_marginBottom="12dp">

            <RadioButton android:id="@+id/radioCat" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🐱 Cat" />
            <RadioButton android:id="@+id/radioMochi" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🍡 Mochi" />
            <RadioButton android:id="@+id/radioBunny" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🐰 Bunny" />
            <RadioButton android:id="@+id/radioPanda" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🐼 Panda" />
        </RadioGroup>

        <TextView android:id="@+id/txtSize" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pet size" android:textColor="#5B4A5A" />
        <SeekBar android:id="@+id/seekSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:layout_marginBottom="8dp" />

        <TextView android:id="@+id/txtBubble" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bubble" android:textColor="#5B4A5A" />
        <SeekBar android:id="@+id/seekBubble" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:layout_marginBottom="8dp" />

        <TextView android:id="@+id/txtRest" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rest" android:textColor="#5B4A5A" />
        <SeekBar android:id="@+id/seekRest" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Auto-wander (pet walks by itself)"
                android:textColor="#5B4A5A" />

            <Switch android:id="@+id/switchWander" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Permissions (needed once)"
            android:textStyle="bold"
            android:textColor="#5B4A5A"
            android:layout_marginBottom="6dp" />

        <Button android:id="@+id/btnOverlayPerm" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1. Allow Display over other apps" android:layout_marginBottom="6dp" />
        <Button android:id="@+id/btnNotifPerm" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="2. Allow Notifications" android:layout_marginBottom="6dp" />
        <Button android:id="@+id/btnBattery" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="3. Ignore battery optimization (stay alive)" android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Try reactions"
            android:textStyle="bold"
            android:textColor="#5B4A5A"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button android:id="@+id/btnTap" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="♡ Happy" />
            <Button android:id="@+id/btnSpin" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🌀 Spin" />
            <Button android:id="@+id/btnSleep" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🌙 Sleep" />
        </LinearLayout>

        <Button android:id="@+id/btnTestBubble" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="How do bubbles &amp; rest reminders work?" android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How to use:\n• Flip ON → pet floats over ANY app (YouTube, WhatsApp, games…)\n• Drag pet to move it • Tap = hearts + cute talk\n• Long-press pet → back to settings\n• Bubble talks pop up automatically\n• Every X min: sleepy rest reminder + notification\n• Notification bar has Turn OFF + Snooze buttons\n• Pet restarts after reboot if left ON ♡"
            android:textColor="#8A7A85"
            android:lineSpacingExtra="3dp" />

    </LinearLayout>
</ScrollView>
